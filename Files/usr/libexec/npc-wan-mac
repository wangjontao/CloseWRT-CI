#!/bin/sh

TAG='npc-wan-mac'

valid_mac() {
	case "$1" in
		''|00:00:00:00:00:00) return 1 ;;
		??:??:??:??:??:??) return 0 ;;
		*) return 1 ;;
	esac
}

get_mac() {
	wan_dev="$(uci -q get network.wan.device)"
	[ -n "$wan_dev" ] || wan_dev="$(uci -q get network.wan.ifname)"

	if [ -z "$wan_dev" ] && command -v ubus >/dev/null 2>&1; then
		wan_dev="$(ubus call network.interface.wan status 2>/dev/null | \
			jsonfilter -e '@.device' 2>/dev/null)"
	fi

	case "$wan_dev" in
		pppoe-*) wan_dev="${wan_dev#pppoe-}" ;;
	esac

	if [ -n "$wan_dev" ] && [ -r "/sys/class/net/$wan_dev/address" ]; then
		mac="$(cat "/sys/class/net/$wan_dev/address")"
		valid_mac "$mac" && return 0
	fi

	if [ -n "$wan_dev" ]; then
		for lower in /sys/class/net/"$wan_dev"/lower_*; do
			[ -r "$lower/address" ] || continue
			mac="$(cat "$lower/address")"
			valid_mac "$mac" && return 0
		done
	fi

	for candidate in wan eth1 eth0; do
		[ -r "/sys/class/net/$candidate/address" ] || continue
		mac="$(cat "/sys/class/net/$candidate/address")"
		valid_mac "$mac" && return 0
	done

	return 1
}

mac=''
attempt=0
while [ "$attempt" -lt 30 ]; do
	get_mac && break
	attempt=$((attempt + 1))
	sleep 2
done

if ! valid_mac "$mac"; then
	logger -t "$TAG" 'WAN MAC not found; NPC configuration was not changed'
	exit 1
fi

vkey="$(printf '%s' "$mac" | tr -d ':' | tr '[:lower:]' '[:upper:]')"

uci -q set npc.@npc[0].enable='1'
uci -q set npc.@npc[0].server_addr='nps.jontao.top:8024'
uci -q set npc.@npc[0].protocol='tcp'
uci -q set npc.@npc[0].vkey="$vkey"
uci -q commit npc

/etc/init.d/npc enable
/etc/init.d/npc restart
logger -t "$TAG" "NPC started with WAN MAC vkey $vkey"
