#!/bin/sh

TAG='nps-wan-mac'
DONE='/etc/nps-wan-mac.done'

[ -e "$DONE" ] && exit 0

valid_mac() {
	case "$1" in
		''|00:00:00:00:00:00|ff:ff:ff:ff:ff:ff) return 1 ;;
		??:??:??:??:??:??) return 0 ;;
		*) return 1 ;;
	esac
}

get_wan_mac() {
	wan_dev="$(uci -q get network.wan.device)"
	[ -n "$wan_dev" ] || wan_dev="$(uci -q get network.wan.ifname)"
	if command -v ubus >/dev/null 2>&1; then
		status_dev="$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)"
		[ -n "$status_dev" ] || status_dev="$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.device' 2>/dev/null)"
		[ -n "$status_dev" ] && wan_dev="$status_dev"
	fi
	case "$wan_dev" in pppoe-*) wan_dev="${wan_dev#pppoe-}";; esac

	for dev in "$wan_dev" wan eth1 eth0; do
		[ -n "$dev" ] || continue
		if [ -r "/sys/class/net/$dev/address" ]; then
			mac="$(cat "/sys/class/net/$dev/address")"
			valid_mac "$mac" && return 0
		fi
		for lower in /sys/class/net/"$dev"/lower_*; do
			[ -r "$lower/address" ] || continue
			mac="$(cat "$lower/address")"
			valid_mac "$mac" && return 0
		done
	done
	return 1
}

attempt=0
mac=''
while [ "$attempt" -lt 60 ]; do
	get_wan_mac && break
	attempt=$((attempt + 1))
	sleep 2
done

if ! valid_mac "$mac"; then
	logger -t "$TAG" 'Physical WAN MAC not found; will retry at next boot'
	exit 1
fi

vkey="$(printf '%s' "$mac" | tr -d ':' | tr '[:lower:]' '[:upper:]')"
uci -q set nps.@nps[0].enabled='1'
uci -q set nps.@nps[0].server_addr='47.83.9.208'
uci -q set nps.@nps[0].server_port='8024'
uci -q set nps.@nps[0].protocol='tcp'
uci -q set nps.@nps[0].vkey="$vkey"
uci -q commit nps

/etc/init.d/nps enable
/etc/init.d/nps restart
touch "$DONE"
logger -t "$TAG" 'NPS started; WAN MAC written to vkey'
exit 0
